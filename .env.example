# Copy to .env and adjust. The real .env is gitignored.

# --- Database -------------------------------------------------------------
# Must match docker/docker-compose.yml. Port 5433 on purpose - 5432 is often
# already taken by a native PostgreSQL install, and that collision looks like an
# authentication failure, not a port conflict.
DATABASE_URL=postgresql://veleiro:veleiro@localhost:5433/veleiro

# --- API ------------------------------------------------------------------
API_PORT=3001

# --- LLM ------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. Not read until Phase 2.
#
# Hosted free tier (default - needs a free API key).
# Confirm the current free model list at https://console.groq.com/docs/models
# before Phase 2; the value below is a placeholder, not a verified id.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# Local Ollama instead (offline, no key, install Ollama natively on Windows):
#   ollama pull qwen2.5:3b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama
