# Copy to .env and adjust. The real .env is gitignored.

# --- Database -------------------------------------------------------------
# Must match docker/docker-compose.yml. Port 5433 on purpose - 5432 is often
# already taken by a native PostgreSQL install, and that collision looks like an
# authentication failure, not a port conflict.
DATABASE_URL=postgresql://veleiro:veleiro@localhost:5433/veleiro

# --- API ------------------------------------------------------------------
API_PORT=3001

# --- LLM ------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint. All three are required.
#
# Hosted free tier (default). Get a key at https://console.groq.com -> API Keys.
# No credit card. Never commit it: this file is the template, the real .env is
# gitignored, and LLM_API_KEY stays empty here.
#
# Why openai/gpt-oss-120b: it is on the free plan, supports tool calling, and
# supports structured outputs. Note the free-plan ceiling is 8K tokens/minute
# and 200K/day, which is what makes the retry-on-429 path in src/llm/retry.ts
# load-bearing rather than defensive.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Local Ollama instead (offline, no key, install Ollama natively on Windows):
#   ollama pull qwen2.5:3b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama
